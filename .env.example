# Server variables. Loaded from the process environment, or with:
# node --env-file=.env server/app.mjs
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.data/axiomer.sqlite
APP_ORIGIN=http://127.0.0.1:8787,http://127.0.0.1:5173,http://localhost:8787,http://localhost:5173
COOKIE_SECURE=0
# In production use your exact HTTPS origin, COOKIE_SECURE=1,
# HOST=0.0.0.0 and a persistent DATABASE_PATH.
# AI provider keys are entered per browser session; never put them in VITE_*.
