{
  "name": "axiomer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:viewer": "tsc -b && VITE_PUBLIC_READONLY=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "graph:validate": "tsx scripts/graph-cli.ts validate",
    "graph:doctor": "tsx scripts/graph-cli.ts doctor",
    "graph:apply": "tsx scripts/graph-cli.ts apply",
    "graph:add": "tsx scripts/graph-cli.ts add"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "dagre": "^0.8.5",
    "lz-string": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
